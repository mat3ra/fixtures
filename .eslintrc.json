{
    "extends": [
        "@mat3ra/eslint-config"
    ],
    "ignorePatterns": [
        "dist/"
    ],
    "settings": {
        "import/resolver": {
            "node": {
                "extensions": [
                    ".js",
                    ".jsx",
                    ".ts",
                    ".tsx"
                ]
            }
        }
    }
}
